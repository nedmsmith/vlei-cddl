; ------------------------------------------------------------
; vLEI CDDL Schema
; ------------------------------------------------------------

vlei-schema =
    lei-cred /
    oor-cred /
    ecr-cred /
    qvi-cred /
    oor-auth-cred /
    ecr-auth-cred /
    ixbri-cred

; The shared type is extended by the supported representation profiles.
said = $said
$said /= said-cbor
$said /= said-json
$said /= said-cesr
$said /= said-urn
; The URN representation is a CESR digest prefixed with "urn:cesr:said:".
; The URN payload is the CESR text defined by said-cesr.
said-urn = $said-urn
$said-urn /= "urn:cesr:said:" .cat said-cesr
; CBOR can carry a CESR representation or an algorithm/digest tuple.
said-cbor = $said-cbor
$said-cbor /= said-cesr
$said-cbor /= said-alg-digest

; hash-alg-id is from the IANA Named Information Hash Algorithm Registry.
said-alg-digest = [
  hash-alg-id: int
  hash-value: bstr
]
; JSON can carry CESR text or an algorithm/digest object.
said-json = $said-json
$said-json /= said-cesr
$said-json /= said-json-alg-digest

; JSON uses a hash-algorithm name and an unpadded base64url digest.
said-json-alg-digest = {
  hash-alg-id: tstr
  hash-value: tstr .regexp "[A-Za-z0-9_-]+"
}
; CESR text is a digest-algorithm code followed by encoded digest text.
said-cesr = $said-cesr
$said-cesr /= said-cesr-256
$said-cesr /= said-cesr-512

said-cesr-256 = $said-cesr-256
$said-cesr-256 /= "E" .cat said-cesr-256-text ; Blake3-256
$said-cesr-256 /= "F" .cat said-cesr-256-text ; Blake2b-256
$said-cesr-256 /= "G" .cat said-cesr-256-text ; Blake2s-256
$said-cesr-256 /= "H" .cat said-cesr-256-text ; SHA3-256
$said-cesr-256 /= "I" .cat said-cesr-256-text ; SHA2-256
said-cesr-256-text = (tstr .size 43) .regexp "[A-Za-z0-9_-]+"

said-cesr-512 = $said-cesr-512
$said-cesr-512 /= "0D" .cat said-cesr-512-text ; Blake3-512
$said-cesr-512 /= "0E" .cat said-cesr-512-text ; Blake2b-512
$said-cesr-512 /= "0F" .cat said-cesr-512-text ; SHA3-512
$said-cesr-512 /= "0G" .cat said-cesr-512-text ; SHA2-512
said-cesr-512-text = (tstr .size 86) .regexp "[A-Za-z0-9_-]+"
; ============================================================
; Common Primitives
; ============================================================
; Core data type primitives used across all vLEI credentials

said-map = { d: said }
aid-map = { i: aid }

aid = tstr / bstr     ; an AID-like inception event digest identifier
date-time = tstr      ; RFC3339-compatible date-time text
; ============================================================
; Node-Schema Pairs
; ============================================================
; Schema node pairs for linking credentials to their schemas

node-schema-pair = {
  n: said    ; node SAID (issuer credential SAID)
  s: said    ; schema SAID (SAID of required schema)
}

; schema specific node-schema-pair for QVI Issuer's Credential
node-schema-pair-qvi = {
  n: said
  s: "EBfdlu8R27Fbx-ehrqwImnK-8Cm79sqbAQ4MmvEAYqao"
}

; schema specific node-schema-pair for LE Issuer's Credential
node-schema-pair-le = {
  n: said
  s: "ENPXp1vQzRF6JwIuS-mp2U8Uf1MoADoP_GqQ62VsDZWY"
}

; ixbri OOR variant that fixes s to the EBNaNu... SAID
node-schema-pair-oor-ixbri = {
  n: said
  s: "EBNaNu-M9P5cgrnfl2Fvymy4E_jvxxyjb70PRtiANlJy"
}

; ixbri ECR variant (fixes s to EEy9...)
node-schema-pair-ecr-ixbri = {
  n: said
  s: "EEy9PkikFcANV1l7EHukCeXqrzT1hNZjGlUk7wuMO5jw"
}
; ============================================================
; Node-Schema Triples
; ============================================================
; Schema node triples for OOR and ECR authorization credentials

node-schema-triple = {
  n: said ; node SAID (issuer credential SAID)
  s: said ; schema SAID (SAID of required schema)
  o: tstr ; operator
}

; auth-le specific triple that constrains s and o to the consts
node-schema-triple-ecr-auth-le = {
  n: said
  s: "EH6ekLjSr8V32WyFbGe1zXjTzFs9PkTYmupJ9H65O14g"
  o: "I2I"
}

node-schema-triple-oor-auth-le = {
  n: said
  s: "EKA57bKBKxr_kN7iN5i7lMUxpMG-s19dRcmov1iDxz-E"
  o: "I2I"
}
; ============================================================
; Disclaimer Texts
; ============================================================
; Canonical legal disclaimer text for vLEI credentials

; canonical literals for each disclaimer
usage-disclaimer-text = "Usage of a valid, unexpired, and non-revoked vLEI Credential, as defined in the associated Ecosystem Governance Framework, does not assert that the Legal Entity is trustworthy, honest, reputable in its business dealings, safe to do business with, or compliant with vlei-any laws or that an implied or expressly intended purpose will be fulfilled."

issuance-disclaimer-text = "All information in a valid, unexpired, and non-revoked vLEI Credential, as defined in the associated Ecosystem Governance Framework, is accurate as of the date the validation process was complete. The vLEI Credential has been issued to the legal entity or person named in the vLEI Credential as the subject; and the qualified vLEI Issuer exercised reasonable care to perform the validation process set forth in the vLEI Ecosystem Governance Framework."

privacy-disclaimer-text = "Privacy Considerations are applicable to QVI ECR AUTH vLEI Credentials.  It is the sole responsibility of QVIs as Issuees of QVI ECR AUTH vLEI Credentials to present these Credentials in a privacy-preserving manner using the mechanisms provided in the Issuance and Presentation Exchange (IPEX) protocol specification and the Authentic Chained Data Container (ACDC) specification.  https://github.com/WebOfTrust/IETF-IPEX and https://github.com/trustoverip/tswg-acdc-specification."
; ============================================================
; Disclaimer Objects
; ============================================================
; Reusable and concrete disclaimer object shapes

; reusable object shape that preserves the l: field
disclaimer-object = {
  l: tstr
}

; concrete disclaimer objects that enforce the exact literal text
usageDisclaimer = { l: usage-disclaimer-text }
issuanceDisclaimer = { l: issuance-disclaimer-text }
privacyDisclaimer = { l: privacy-disclaimer-text }
; Legal Entity vLEI Credential

lei-cred = [
    lei-boilerplate,
    lei-properties
]
; ============================================================
; LEI Boilerplate
; ============================================================
; Legal Entity vLEI Credential boilerplate metadata

lei-boilerplate = {
    ? "$id": "ENPXp1vQzRF6JwIuS-mp2U8Uf1MoADoP_GqQ62VsDZWY",
    ? "$schema": "http://json-schema.org/draft-07/schema#",
    ? title: "Legal Entity vLEI Credential",
    ? description: "A vLEI Credential issued by a Qualified vLEI issuer to a Legal Entity",
    ? type: "object",
    ? credentialType: "LegalEntityvLEICredential",
    ? version: "1.0.0"
}
; ============================================================
; LEI Properties Block
; ============================================================
; Top-level properties for Legal Entity vLEI Credential

lei-properties = {
; structural attributes
    v: tstr,  ; Version
    d: said,  ; Credential SAID
    u: tstr,  ; One time use high entropy nonce
    i: aid,   ; Credential Issuer - a QVI entity
    ri: tstr, ; Credential status registry
    s: said,  ; SAID of this lei schema
; subject attributes
    a: lei-a,
; edge properties
    e: lei-e,
; rule properties
    r: lei-r
}
; ============================================================
; LEI Attributes Block
; ============================================================
; Attributes block for Legal Entity vLEI Credential

lei-a = said / lei-a-properties

lei-a-boilerplate = { ; Attributes block boilerplate
    "$id": "EJ6bFDLrv50bHmIDg-MSummpvYWsPa9CFygPUZyHoESj"
}

lei-a-properties = {
    ? d: said ; lei Attributes block SAID
    i: aid    ; AID of legal entity issuee
    dt: date-time ; issuance date time
    LEI: tstr ; LEI of the Legal Entity in ISO 17442 format
}
; ============================================================
; LEI Edges Block
; ============================================================
; Edges block for linking to QVI node

lei-e = said / ; Edges block SAID
    lei-e-properties ; Edges block SAD

lei-e-boilerplate = { ; Edges block boilerplate
    "$id": "EDh9sp5cPk0-yo5sFMo6WJS1HMBYIOYCwJrnPvNaH1vI"
}

lei-e-properties = {
    d: said ; Edges block SAID
    qvi: node-schema-pair-qvi ; QVI node
}
; ============================================================
; LEI Rules Block
; ============================================================
; Rules block containing legal disclaimers

lei-r = said / ; Rules block SAID
    lei-r-properties

lei-r-boilerplate = { ; Rules block boilerplate
    "$id": "ECllqarpkZrSIWCb97XlMpEZZH3q4kc--FQ9mbkFMb_5"
}

lei-r-properties = {
    d: said ; Rules block SAID
    ; Legal disclaimers
    usageDisclaimer: usageDisclaimer
    issuanceDisclaimer: issuanceDisclaimer
}
; Official Organizational Role vLEI Credential

oor-cred = [
    oor-boilerplate,
    oor-properties
]
; ============================================================
; OOR Boilerplate
; ============================================================
; Official Organizational Role vLEI Credential boilerplate

oor-boilerplate = {
    ? "$id": "EBNaNu-M9P5cgrnfl2Fvymy4E_jvxxyjb70PRtiANlJy",
    ? "$schema": "http://json-schema.org/draft-07/schema#",
    ? title: "Legal Entity Official Organizational Role vLEI Credential",
    ? description: "A vLEI Role Credential issued by a Qualified vLEI issuer to official representatives of a Legal Entity",
    ? type: "object",
    ? credentialType: "LegalEntityOfficialOrganizationalRolevLEICredential",
    ? version: "1.0.0"
}
; ============================================================
; OOR Properties Block
; ============================================================
; Top-level properties for OOR vLEI Credential

oor-properties = {
    v: tstr ; Version
    d: said ; Credential SAID
    u: tstr ; One time use high entropy nonce
    i: aid ; QVI Issuer AID
    ri: tstr ; Credential status registry 
    s: said ; Schema SAID
    a: oor-a,
    e: oor-e,
    r: oor-r
}
; ============================================================
; OOR Attributes Block
; ============================================================
; Attributes block for OOR vLEI Credential

oor-a = said / ; Attributes block SAID
    oor-a-properties

oor-a-boilerplate = {
        "$id": "ELDXjQ-FnKApK1DJhzmtKDcnfoJ9qusQr1Qz5g9MFt0o",
}

oor-a-properties = {
        ? d: said ; Attributes block SAID
        i: aid ; Person Issuee AID
        dt: date-time ; Issuance date time
        LEI: tstr ; LEI of the Legal Entity" in ISO17442 format
        personLegalName: tstr ; Recipient name as provided during identity assurance
        officialRole: tstr ; Official role title
}
; ============================================================
; OOR Edges Block
; ============================================================
; Edges block for linking to Auth and LE credentials

oor-e = said / ; Edges block SAID
    oor-e2auth-properties /
    oor-e2le-properties

; ============================================================
; OOR Edges - Auth variant
; ============================================================

oor-e2auth-boilerplate = {
    "$id": "EMsSqaJsthSBA4OINZ1_fxfNVkgEPF-Sg5fq-vXM7Z6b"
}

oor-e2auth-properties = {
    d: said ; Edges block SAID
    auth: node-schema-triple-oor-auth-le ; Chain to Auth vLEI credential from legal entity
}

; ============================================================
; OOR Edges - LE variant
; ============================================================

oor-e2le-properties = {
    d: said ; Edges block SAID
    le: node-schema-pair-le ; Chain to Legal Entity vLEI credential
}
; ============================================================
; OOR Rules Block
; ============================================================
; Rules block containing legal disclaimers

oor-r = said / ; Rules block SAID
    oor-r-properties

oor-r-boilerplate = {
    "$id": "ECllqarpkZrSIWCb97XlMpEZZH3q4kc--FQ9mbkFMb_5"
}

oor-r-properties = {
    d: said ; Rules block SAID
    usageDisclaimer: usageDisclaimer
    issuanceDisclaimer: issuanceDisclaimer
}
; Engagement Context Role vLEI Credential

ecr-cred = [
    ecr-boilerplate,
    ecr-properties
]
; ============================================================
; ECR Boilerplate
; ============================================================
; Engagement Context Role vLEI Credential boilerplate

ecr-boilerplate = {
    ? "$id": "EEy9PkikFcANV1l7EHukCeXqrzT1hNZjGlUk7wuMO5jw",
    ? "$schema": "http://json-schema.org/draft-07/schema#",
    ? title: "Legal Entity Engagement Context Role vLEI Credential",
    ? description: "A vLEI Role Credential issued to representatives of a Legal Entity in other than official roles but in functional or other context of engagement",
    ? type: "object",
    ? credentialType: "LegalEntityEngagementContextRolevLEICredential",
    ? version: "1.0.0"
}
; ============================================================
; ECR Properties Block
; ============================================================
; Top-level properties for ECR vLEI Credential

ecr-properties = {
    v: tstr ; Version
    d: said ; Credential SAID
    u: tstr ; A high entropy nonce
    i: aid ; QVI or LE Issuer AID
    ri: tstr ; Credential status registry
    s: said ; Schema SAID
    a: ecr-a,
    e: ecr-e,
    r: ecr-r
}
; ============================================================
; ECR Attributes Block
; ============================================================
; Attributes block for ECR vLEI Credential

ecr-a = said / ; Attributes block SAID
    ecr-a-properties

ecr-a-boilerplate = {
    "$id": "EDv4wiOMHE125CXu-EuOd0YRXz-AgpLilJfjoODFqtHD"
}

ecr-a-properties = {
    ? d: said ; Attributes block SAID
    ? u: tstr ; A high entropy nonce
    i: aid ; Person Issuee AID
    dt: date-time ; Issuance date time
    LEI: tstr ; LEI of the Legal Entity" in ISO17442 format
    personLegalName: tstr ; Recipient name as provided during identity assurance
    engagementContextRole: tstr ; Role description i.e. 'Head of Standards'
}
; ============================================================
; ECR Edges Block
; ============================================================
; Edges block for linking to Auth and LE credentials

ecr-e = said / ; Edges block SAID
    ecr-e2auth-properties /
    ecr-e2le-properties

; ============================================================
; ECR Edges - Auth variant
; ============================================================

ecr-e2auth-boilerplate = {
    "$id": "EEM9OvWMEmAfAY0BV2kXatSc8WM13QW1B5y33E8z4f33"
}

ecr-e2auth-properties = {
    d: said ; Edges block SAID
    auth: node-schema-triple-ecr-auth-le ; Chain to Auth vLEI credential from legal entity
}

; ============================================================
; ECR Edges - LE variant
; ============================================================

ecr-e2le-boilerplate = { ; Edges block for issuance from Legal Entity
    "$id": "EHeZGaLBhCc_-sAcyAEgFFeCkxgnqCubPOBuEvoh9jHX"
}

ecr-e2le-properties = {
    d: said ; SAID of edges block
    le: node-schema-pair-le ; Chain to legal entity vLEI credential
}
; ============================================================
; ECR Rules Block
; ============================================================
; Rules block containing legal disclaimers

ecr-r = said / ; Rules block SAID
    ecr-r-properties

ecr-r-boilerplate = {
    "$id": "ECllqarpkZrSIWCb97XlMpEZZH3q4kc--FQ9mbkFMb_5"
}

ecr-r-properties = {
    d: said ; Rules block SAID
    usageDisclaimer: usageDisclaimer
    issuanceDisclaimer: issuanceDisclaimer
}
; Qualified vLEI Issuer Credential

qvi-cred = [
    qvi-boilerplate,
    qvi-properties
]
; ============================================================
; QVI Boilerplate
; ============================================================
; Qualified vLEI Issuer Credential boilerplate

qvi-boilerplate = {
    ? "$id": "EBfdlu8R27Fbx-ehrqwImnK-8Cm79sqbAQ4MmvEAYqao",
    ? "$schema": "http://json-schema.org/draft-07/schema#",
    ? title: "Qualified vLEI Issuer Credential",
    ? description: "A vLEI Credential issued by GLEIF to Qualified vLEI Issuers which allows the Qualified vLEI Issuers to issue, verify and revoke Legal Entity vLEI Credentials and Legal Entity Official Organizational Role vLEI Credentials",
    ? type: "object",
    ? credentialType: "QualifiedvLEIIssuervLEICredential",
    ? version: "1.0.0"
}
; ============================================================
; QVI Properties Block
; ============================================================
; Top-level properties for QVI vLEI Credential

qvi-properties = {
    v: tstr ; Version
    d: said ; Credential SAID
    u: tstr ; One time use high entropy nonce
    i: aid ; GLEIF Issuee AID
    ri: tstr ; Credential status registry
    s: said ; Schema SAID
    a: qvi-a,
    r: qvi-r
}
; ============================================================
; QVI Attributes Block
; ============================================================
; Attributes block for QVI vLEI Credential

qvi-a = said / ; Attributes block SAID
    qvi-a-properties

qvi-a-boilerplate = { ; Attributes block boilerplate
    "$id": "ELGgI0fkloqKWREXgqUfgS0bJybP1LChxCO3sqPSFHCj"
}

qvi-a-properties = {
    ? d: said ; Attributes block SAID
    i: aid ; QVI Issuee AID
    dt: date-time ; Issuance date time
    LEI: tstr ; LEI of the requesting Legal Entity in ISO 17442 format
    ? gracePeriod: int .default 90;Allocated grace period default: 90
}
; ============================================================
; QVI Rules Block
; ============================================================
; Rules block containing legal disclaimers

qvi-r = said / ; Rules block SAID
    qvi-r-properties

qvi-r-boilerplate = { ; Rules block boilerplate
    "$id": "ECllqarpkZrSIWCb97XlMpEZZH3q4kc--FQ9mbkFMb_5"
}

qvi-r-properties = {
    d: said ;Rules block SAID"
    ; Legal disclaimers
    usageDisclaimer: usageDisclaimer
    issuanceDisclaimer: issuanceDisclaimer
}
; OOR Authorization vLEI Credential

oor-auth-cred = [
    oor-auth-boilerplate,
    oor-auth-properties
]
; ============================================================
; OOR-Auth Boilerplate
; ============================================================
; OOR Authorization vLEI Credential boilerplate

oor-auth-boilerplate = {
    ? "$id": "EKA57bKBKxr_kN7iN5i7lMUxpMG-s19dRcmov1iDxz-E",
    ? "$schema": "http://json-schema.org/draft-07/schema#",
    ? title: "OOR Authorization vLEI Credential",
    ? description: "A vLEI Authorization Credential issued by a Legal Entity to a QVI for the authorization of OOR credentials",
    ? type: "object",
    ? credentialType: "OORAuthorizationvLEICredential",
    ? version: "1.0.0"
}
; ============================================================
; OOR-Auth Properties Block
; ============================================================
; Top-level properties for OOR-Auth vLEI Credential

oor-auth-properties = {
    v: tstr ; Version
    d: said ; Credential SAID
    u: tstr ; Single use high entropy nonce
    i: aid ; LE Issuer AID
    ri: tstr ; Credential status registry
    s: said ; Schema SAID
    a: oor-auth-a,
    e: oor-auth-e,
    r: oor-auth-r
}
; ============================================================
; OOR-Auth Attributes Block
; ============================================================
; Attributes block for OOR-Auth vLEI Credential

oor-auth-a = said / ; Attributes block SAID
    oor-auth-a-properties

oor-auth-a-boilerplate = {
    "$id": "EPli-kppZ4gj8g4i3-FUx3ZG1H_UrMhXwzyP1E6uAot6"
}

oor-auth-a-properties = {
    ? d: said ; Attributes block SAID
    i: aid ; QVI Issuee AID
    dt: date-time ; Issuance date time
    AID: aid ; AID of the intended recipient of the ECR credential
    LEI: tstr ; LEI of the requesting Legal Entity
    personLegalName: tstr ; Requested recipient name
    officialRole: tstr ; Requested role description
}
; ============================================================
; OOR-Auth Edges Block
; ============================================================
; Edges block for linking to LE credential

oor-auth-e = said / ; Edges block SAID
    oor-auth-e-properties

oor-auth-e-boilerplate = {
    "$id": "EB6E1GJvVen5NqkKb2TG5jqX66vYOL3md-xkXQqQBySX"
}

oor-auth-e-properties = {
    d: said ; Edges block SAID
    le: node-schema-pair-le ; Chain to legal entity vLEI credential
}
; ============================================================
; OOR-Auth Rules Block
; ============================================================
; Rules block containing legal disclaimers

oor-auth-r = said / ; Rules block SAID
    oor-auth-r-properties

oor-auth-r-boilerplate = {
    "$id": "ECllqarpkZrSIWCb97XlMpEZZH3q4kc--FQ9mbkFMb_5"
}

oor-auth-r-properties = {
    d: said ; Rules block SAID
    usageDisclaimer: usageDisclaimer
    issuanceDisclaimer: issuanceDisclaimer
}
; ECR Authorization vLEI Credential

ecr-auth-cred = [
    ecr-auth-boilerplate,
    ecr-auth-properties
]
; ============================================================
; ECR-Auth Boilerplate
; ============================================================
; ECR Authorization vLEI Credential boilerplate

ecr-auth-boilerplate = {
    ? "$id": "EH6ekLjSr8V32WyFbGe1zXjTzFs9PkTYmupJ9H65O14g",
    ? "$schema": "http://json-schema.org/draft-07/schema#",
    ? title: "ECR Authorization vLEI Credential",
    ? description: "A vLEI Authorization Credential issued by a Legal Entity to a QVI for the authorization of ECR credentials",
    ? type: "object",
    ? credentialType: "ECRAuthorizationvLEICredential",
    ? version: "1.0.0"
}
; ============================================================
; ECR-Auth Properties Block
; ============================================================
; Top-level properties for ECR-Auth vLEI Credential

ecr-auth-properties = {
    v: tstr ; Version
    d: said ; Credential SAID
    u: tstr ; One time use high entropy nonce
    i: aid ; LE Issuer AID
    ri: tstr ; Credential status registry
    s: said ; Schema SAID
    a: ecr-auth-a,
    e: ecr-auth-e,
    r: ecr-auth-r
}
; ============================================================
; ECR-Auth Attributes Block
; ============================================================
; Attributes block for ECR-Auth vLEI Credential

ecr-auth-a = said / ; Attributes block SAID
    ecr-auth-a-properties

ecr-auth-a-boilerplate = { ; Attributes block boilerplate
    "$id": "EBMwtCJt7LUfA9u0jmZ1cAoCavZFIBmZBmlufYeX4gdy"
}

ecr-auth-a-properties = {
    ? d: said ; Attributes block SAID
    i: aid ; QVI Issuee AID
    dt: date-time ; Issuance date time
    AID: aid ; AID of the intended recipient of the ECR credential
    LEI: tstr ; LEI of the requesting Legal Entity in iso17442 format
    personLegalName: tstr ; Requested recipient name as provided during identity assurance
    engagementContextRole: tstr ; Requested role description i.e. 'Head of Standards'
}
; ============================================================
; ECR-Auth Edges Block
; ============================================================
; Edges block for linking to LE credential

ecr-auth-e = said / ; Edges block SAID
    ecr-auth-e-properties

ecr-auth-e-boilerplate = { ; Edges block boilerplate
    "$id": "EB6E1GJvVen5NqkKb2TG5jqX66vYOL3md-xkXQqQBySX"
}

ecr-auth-e-properties = {
    d: said ; Edges block SAID
    ; Chain to legal entity vLEI credential
    le: node-schema-pair-le ; QVI Issuer credential
}
; ============================================================
; ECR-Auth Rules Block
; ============================================================
; Rules block containing legal disclaimers including privacy

ecr-auth-r = said / ; Rules block SAID
    ecr-auth-r-properties

ecr-auth-r-boilerplate = { ; Rules block boilerplate
    "$id": "ELLuSgEW2h8n5fHKLvZc9uTtxzqXQqlWR7MiwEt7AcmM",
}

ecr-auth-r-properties = {
    d: said ; Rules block SAID
    usageDisclaimer: usageDisclaimer
    issuanceDisclaimer: issuanceDisclaimer
    privacyDisclaimer: privacyDisclaimer
}
; iXBRL Data Value Attestation

ixbri-cred = [
    ixbri-boilerplate,
    ixbri-properties
]
; ============================================================
; iXBRL Boilerplate
; ============================================================
; iXBRL Data Value Attestation boilerplate

ixbri-boilerplate = {
    ? "$id": "EMhvwOlyEJ9kN4PrwCpr9Jsv7TxPhiYveZ0oP3lJzdEi",
    ? "$schema": "http://json-schema.org/draft-07/schema#",
    ? title: "iXBRL Data Value Attestation",
    ? description: "A data attestation against an iXBRL report, linked to either a vLEI OOR or vLEI ECR credential",
    ? type: "object",
    ? credentialType: "iXBRLDataAttestation"
}
; ============================================================
; iXBRL Properties Block
; ============================================================
; Top-level properties for iXBRL Data Value Attestation

ixbri-properties = {
    v: tstr ; Version
    d: said ; SAID of this credential
    i: aid ; AID of the issuer
    ri: tstr ; Credential status registry
    s: said ; Schema SAID
    a: ixbri-a
    e: ixbri-e
}
; ============================================================
; iXBRL Fact Definition
; ============================================================
; Individual iXBRL fact structure

ixbri-fact = {
    i: tstr ; XBRL data element ID
    t: tstr ; XBRL element type (qname)
    d: tstr ; Digest of canonicalized XBRL attribute
    v: tstr ; Data value
    f: tstr ; Data type
    c: tstr ; XBRL Element Context
    e: tstr ; Unknown
    p: tstr ; Date range
}
; ============================================================
; iXBRL Attributes / Data Block
; ============================================================
; Data block containing iXBRL facts

ixbri-a = ixbri-a-properties

ixbri-a-boilerplate = { ; data block boilerplate
    "$id": "EDj-Pm8CNw80aA5djaobjhM__eFeAZIIkgo1-nfkB7M1",
}

ixbri-a-properties = {
    d: said ; SAID of the data block
    dt: date-time ; signed date time
    rd: tstr ; Digest of entire signed iXBRL report
    ; Signed facts of report
    f: [ + ixbri-fact ] ; Array of iXBRL facts
}
; ============================================================
; iXBRL Edges Block
; ============================================================
; Edges block for linking to OOR or ECR credentials

ixbri-e = ixbri-e2oor-properties / ixbri-e2ecr-properties

; ============================================================
; iXBRL Edges - OOR variant
; ============================================================

; Option 1: OOR Credential edge
ixbri-e2oor-boilerplate = { ; Chained vLEI OOR Credential
    "$id": "EGdpNTt_v5NAIhzWZjisHE5oaYnoJVOC7iVFySw9eFKX"
}

ixbri-e2oor-properties = {
    d: said ; SAID of edge block containing OOR Credential node
    oor: node-schema-pair-oor-ixbri ; node SAID of signer OOR credential
}

; ============================================================
; iXBRL Edges - ECR variant
; ============================================================

; Option 2: ECR Credential edge
ixbri-e2ecr-boilerplate = { ; Chained vLEI ECR Credential{
    "$id": "EO2AOkCvsjm5RyQYAPpUZP96pbXlPGym57VemjxlOlMe"
}

ixbri-e2ecr-properties = {
    d: said ; { SAID of edge block containing ECR Credential node
    ecr: node-schema-pair-ecr-ixbri ; node SAID of signer ECR credential
}
