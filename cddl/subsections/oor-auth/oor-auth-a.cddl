; Attributes block for OOR-Auth vLEI Credential

oor-auth-a = said / ; Attributes block SAID
    oor-auth-a-properties

oor-auth-a-boilerplate = {
    "$id": "EPli-kppZ4gj8g4i3-FUx3ZG1H_UrMhXwzyP1E6uAot6"
}

oor-auth-a-properties = {
    ? d: said ; Attributes block SAID
    i: aid ; QVI Issuee AID
